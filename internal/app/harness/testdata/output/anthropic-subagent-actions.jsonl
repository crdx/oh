{"kind":"head","version":20,"meta":{"model":"claude-opus-5","workspaceDir":"","provider":"anthropic","effort":"medium","system_prompt":"You are a test assistant.","tools":["subagent"],"tool_definitions":[{"name":"subagent","description":"start independent subagents with a shared optional system prompt and individual tasks, send a finished subagent a follow-up, and inspect or control them by name; at most 5 run at once; a subagent knows only a short description of its sandbox, your system_prompt, and its prompt: none of your instructions, context files or conversation reach it, so give it everything it needs; each subagent can read but not write its workspace, and has a shell only while you do, writing only to its own scratch, which you reach as subagents/\u003cname\u003e inside yours; finished subagents whose answers you have not read through wait or output report back after a short batching window","revision":"1","parameters":[{"name":"action","type":"string","description":"what to do","values":["start","send","status","output","wait","stop","list"]},{"name":"names","type":"array","item_type":"string","description":"the subagents for status, output, wait, or stop; empty means all of them","optional":true},{"name":"wait_seconds","type":"integer","description":"how many seconds to wait at most — max 10m (default)","optional":true},{"name":"name","type":"string","description":"the finished subagent to send a follow-up to (for send)","optional":true},{"name":"message","type":"string","description":"the follow-up to send (for send)","optional":true},{"name":"system_prompt","type":"string","description":"the only instructions every subagent shares, beside a short description of its sandbox (for start)","optional":true},{"name":"subagents","type":"array","item_type":"object","item_fields":[{"name":"prompt","type":"string","description":"the whole task for this subagent, with whatever context it needs"},{"name":"intent","type":"string","description":"what this subagent is 