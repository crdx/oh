\e[38;2;150;152;150m┌──────┬────────────────────────────────────────────┐\e[0m\r
\e[38;2;150;152;150m│\e[0m \e[1mTool\e[0m \e[38;2;150;152;150m│\e[0m \e[1mWhat it does when it is asked to\e[0m           \e[38;2;150;152;150m│\e[0m\r
\e[38;2;150;152;150m├──────┼────────────────────────────────────────────┤\e[0m\r
\e[38;2;150;152;150m│\e[0m read \e[38;2;150;152;150m│\e[0m takes a file and hands it back to you      \e[38;2;150;152;150m│\e[0m\r
\e[38;2;150;152;150m├──────┼────────────────────────────────────────────┤\e[0m\r
\e[38;2;150;152;150m│\e[0m grep \e[38;2;150;152;150m│\e[0m walks the whole tree looking for a pattern \e[38;2;150;152;150m│\e[0m\r
\e[38;2;150;152;150m└──────┴────────────────────────────────────────────┘\e[0m\r
